{
  "name": "supergds-studio",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build:frontend": "esbuild frontend/studio.ts frontend/monacoSetup.ts frontend/iframeBridge.ts frontend/terminal.ts --bundle --platform=browser --outdir=frontend --format=iife --sourcemap --external:monaco-editor --allow-overwrite",
    "dev": "npm run build:frontend && tsx watch server/index.ts",
    "build": "tsc",
    "start": "node dist/server/index.js",
    "test:e2e": "npx playwright test tests/e2e"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.0",
    "@fastify/sensible": "^6.0.0",
    "@fastify/static": "^8.0.0",
    "@fastify/websocket": "^11.2.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "browser-use": "^0.6.1",
    "fastify": "^5.1.0",
    "monaco-editor": "^0.55.1",
    "node-pty": "^1.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "@types/node": "^22.0.0",
    "esbuild": "^0.28.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
